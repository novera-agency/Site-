# Optionnel : active la couche conversationnelle IA des PNJ (côté serveur uniquement).
# Sans clé, le jeu fonctionne entièrement avec des dialogues scénarisés déterministes.
ANTHROPIC_API_KEY=
# Modèle utilisé pour les PNJ (facultatif)
AI_MODEL=claude-sonnet-5-5
# Secret de signature des cookies de session (à définir en production)
SESSION_SECRET=change-me-in-production
# Répertoire de stockage des sauvegardes (par défaut ./data/saves)
SAVE_DIR=
